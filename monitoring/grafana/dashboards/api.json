{
  "title": "Heart API Monitoring",
  "uid": "heart-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests per second", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "sum(rate(api_requests_total[1m])) by (endpoint)", "legendFormat": "{{endpoint}}", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "p95 latency (s)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket[1m])) by (le, endpoint))", "legendFormat": "{{endpoint}}", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Predictions by class", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "model_predictions_total", "legendFormat": "class {{label}}", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "Error responses (4xx/5xx) per second", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "sum(rate(api_requests_total{status=~\"4..|5..\"}[1m]))", "legendFormat": "errors", "refId": "A"}]}
  ]
}
